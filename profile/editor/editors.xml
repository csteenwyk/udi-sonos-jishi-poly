<editors>
  <!-- Volume: 0-100 percent -->
  <editor id="E_VOL">
    <range uom="51" min="0" max="100" prec="0"/>
  </editor>

  <!-- Bass/Treble: -10 to 10 -->
  <editor id="E_EQ">
    <range uom="56" min="-10" max="10" step="1"/>
  </editor>

  <!-- Playback State -->
  <editor id="E_PLAYBACK">
    <range uom="25" subset="0,1,2,3" nls="CUST_PB"/>
  </editor>

  <!-- Boolean -->
  <editor id="E_BOOL">
    <range uom="2" subset="0,1"/>
  </editor>

  <!-- Repeat -->
  <editor id="E_REPEAT">
    <range uom="25" subset="0,1,2" nls="CUST_REPEAT"/>
  </editor>

  <!-- Sleep timer in minutes -->
  <editor id="E_SLEEP">
    <range uom="25" subset="0,15,30,45,60,90" nls="CUST_SLEEP"/>
  </editor>

  <!-- Controller status -->
  <editor id="E_STATUS">
    <range uom="2" subset="0,1"/>
  </editor>

  <!-- Dynamic — populated at runtime by sonos-poly.py -->
  <editor id="E_FAV">
    <range uom="25" subset="0" nls="CUST_FAV"/>
  </editor>

  <editor id="E_PLAYLIST">
    <range uom="25" subset="0" nls="CUST_PL"/>
  </editor>

  <editor id="E_TTS">
    <range uom="25" subset="0" nls="CUST_TTS"/>
  </editor>

  <editor id="E_CLIP">
    <range uom="25" subset="0" nls="CUST_CLIP"/>
  </editor>

  <editor id="E_ZONES">
    <range uom="25" subset="0" nls="CUST_ZONE"/>
  </editor>
</editors>
