<nodeDefs>

  <!-- Controller Node -->
  <nodeDef id="sonos_controller" nodeType="139" nls="sonos_controller">
    <sts>
      <st id="ST" editor="E_STATUS"/>
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
        <cmd id="DISCOVER"/>
        <cmd id="PAUSE_ALL"/>
        <cmd id="RESUME_ALL"/>
        <cmd id="UNGROUP_ALL"/>
        <cmd id="PARTY"/>
        <cmd id="REFRESH_CONTENT"/>
        <cmd id="SAY_ALL">
          <p id="" editor="E_TTS"/>
        </cmd>
      </accepts>
    </cmds>
  </nodeDef>

  <!-- Speaker Node -->
  <nodeDef id="sonos_speaker" nodeType="139" nls="sonos_speaker">
    <sts>
      <st id="ST"   editor="E_PLAYBACK"/> <!-- Playback state -->
      <st id="SVOL" editor="E_VOL"/>      <!-- Player volume -->
      <st id="GV1"  editor="E_VOL"/>      <!-- Group volume -->
      <st id="GV2"  editor="E_EQ"/>       <!-- Bass -->
      <st id="GV3"  editor="E_EQ"/>       <!-- Treble -->
      <st id="GV4"  editor="E_BOOL"/>     <!-- Mute -->
      <st id="GV5"  editor="E_BOOL"/>     <!-- Group mute -->
      <st id="GV6"  editor="E_BOOL"/>     <!-- Shuffle -->
      <st id="GV7"  editor="E_REPEAT"/>   <!-- Repeat -->
      <st id="GV8"  editor="E_BOOL"/>     <!-- Crossfade -->
      <st id="GV9"  editor="E_BOOL"/>     <!-- Loudness -->
      <st id="GV10" editor="E_BOOL"/>     <!-- Nightmode -->
      <st id="GV11" editor="E_BOOL"/>     <!-- Speech enhancement -->
      <st id="GV12" editor="E_EQ"/>       <!-- Members in group -->
    </sts>
    <cmds>
      <sends/>
      <accepts>
        <cmd id="QUERY"/>
        <cmd id="DON"/>
        <cmd id="DOF"/>
        <cmd id="NEXT"/>
        <cmd id="PREV"/>
        <cmd id="SET_VOL">
          <p id="" editor="E_VOL" init="SVOL"/>
        </cmd>
        <cmd id="SET_GRP_VOL">
          <p id="" editor="E_VOL" init="GV1"/>
        </cmd>
        <cmd id="SET_BASS">
          <p id="" editor="E_EQ" init="GV2"/>
        </cmd>
        <cmd id="SET_TREBLE">
          <p id="" editor="E_EQ" init="GV3"/>
        </cmd>
        <cmd id="MUTE">
          <p id="" editor="E_BOOL" init="GV4"/>
        </cmd>
        <cmd id="SHUFFLE">
          <p id="" editor="E_BOOL" init="GV6"/>
        </cmd>
        <cmd id="REPEAT">
          <p id="" editor="E_REPEAT" init="GV7"/>
        </cmd>
        <cmd id="CROSSFADE">
          <p id="" editor="E_BOOL" init="GV8"/>
        </cmd>
        <cmd id="PLAY_FAVORITE">
          <p id="" editor="E_FAV"/>
        </cmd>
        <cmd id="PLAY_PLAYLIST">
          <p id="" editor="E_PLAYLIST"/>
        </cmd>
        <cmd id="SAY">
          <p id="" editor="E_TTS"/>
        </cmd>
        <cmd id="SLEEP">
          <p id="" editor="E_SLEEP"/>
        </cmd>
        <cmd id="JOIN">
          <p id="" editor="E_ZONES"/>
        </cmd>
        <cmd id="LEAVE"/>
        <cmd id="PARTY"/>
      </accepts>
    </cmds>
  </nodeDef>

</nodeDefs>
